# Self-hosted signaling mode (no Supabase account required)
SHILLING_AUTH_MODE=none

# Optional hosted mode: set SHILLING_AUTH_MODE=supabase and configure these values.
# SHILLING_SUPABASE_URL=https://your-project-ref.supabase.co

# Client-side key served from /api/config.
# Use your Supabase publishable key here even though the env var name says "ANON_KEY".
# SHILLING_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Server-only key used for hosted metadata lookup.
# Use a rotated sb_secret_... key here.
# SHILLING_SUPABASE_SERVICE_KEY=sb_secret_your_server_secret_key

# Optional legacy JWT secret for old HS256 projects only.
# Leave unset for modern Supabase projects using RSA/ECC signing keys.
# SHILLING_SUPABASE_JWT_SECRET=

# Optional TURN config
# SHILLING_STUN_URLS=stun:stun.l.google.com:19302
# SHILLING_TURN_URLS=turn:turn.example.com:3478
# SHILLING_TURN_SECRET=replace_me
# SHILLING_TURN_TTL=86400

# Optional server tracing with the OpenTelemetry Java agent bundled in the server image.
# Keep the ingest key in your deployment secret store, never in this file.
# JAVA_TOOL_OPTIONS=-javaagent:/opt/opentelemetry-javaagent.jar
# OTEL_SERVICE_NAME=shilling-signaling
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.maple.dev
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <ingest-key>
# OTEL_LOGS_EXPORTER=none
