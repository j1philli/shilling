# Self-hosted signaling mode (no Supabase account required)
SHILLING_AUTH_MODE=none
# Optional signaling bind address (defaults shown).
# SHILLING_SERVER_HOST=0.0.0.0
# SHILLING_SERVER_PORT=8081

# Optional hosted mode: set SHILLING_AUTH_MODE=supabase and configure these values.
# SHILLING_SUPABASE_URL=https://your-project-ref.supabase.co

# Client-side key served from /api/config.
# Use your Supabase publishable key here even though the env var name says "ANON_KEY".
# SHILLING_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Server-only key used for hosted metadata lookup.
# Use a rotated sb_secret_... key here.
# SHILLING_SUPABASE_SERVICE_KEY=sb_secret_your_server_secret_key

# Optional legacy JWT secret for old HS256 projects only.
# Leave unset for modern Supabase projects using RSA/ECC signing keys.
# SHILLING_SUPABASE_JWT_SECRET=

# Optional TURN config
# SHILLING_STUN_URLS=stun:stun.l.google.com:19302
# SHILLING_TURN_URLS=turn:turn.example.com:3478
# SHILLING_TURN_SECRET=replace_me
# SHILLING_TURN_TTL=86400

# Optional server tracing with the OpenTelemetry Java agent bundled in the server image.
# Keep the ingest key in your deployment secret store, never in this file.
# JAVA_TOOL_OPTIONS=-javaagent:/opt/opentelemetry-javaagent.jar
# OTEL_SERVICE_NAME=shilling-signaling
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.maple.dev
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <ingest-key>
# OTEL_LOGS_EXPORTER=none

# Backup control plane (signaling server only). Use a unique random secret per worker.
# SHILLING_BACKUP_WORKERS=worker-1=<at-least-32-random-characters>
# Self-hosted only: persist this file; one server process owns it.
# SHILLING_BACKUP_POLICY_FILE=/data/backup-policy.json
# Hosted signaling servers use a separate restricted Postgres role for policies and assignments.
# SHILLING_CLOUD_CONTROL_DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
# SHILLING_CLOUD_CONTROL_DATABASE_USER=shilling_cloud_control
# SHILLING_CLOUD_CONTROL_DATABASE_PASSWORD=<control-role-password>
# SHILLING_BACKUP_WORKER_CAPACITY=256
# Enable only when every backup worker has a protected storage key configured.
# SHILLING_BACKUP_TRUSTED_CLOUD_ENABLED=false

# Independent multi-household cloud peer (use a separate environment from the signaling server).
# SHILLING_BACKUP_SERVER_URL=https://api.shilling.finance
# SHILLING_BACKUP_WORKER_SECRET=<matching-worker-secret>
# SHILLING_BACKUP_DATA_DIR=/data/backups
# auto: hosted auth -> Supabase Postgres; self-hosted -> SQLite. Hosted rejects sqlite.
# SHILLING_BACKUP_STORAGE=auto
# Hosted worker only; fresh setup: supabase/cloud-peer.sql and supabase/cloud-storage.sql.
# Use the dedicated database role, not a Supabase API key. Mount the project's CA cert.
# SHILLING_BACKUP_DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
# SHILLING_BACKUP_DATABASE_USER=shilling_backup_worker
# SHILLING_BACKUP_DATABASE_PASSWORD=<database-role-password>
# SHILLING_BACKUP_DATABASE_POOL_SIZE=8
# Worker-only Storage API credential (secret API key or service-role JWT); never expose to devices.
# SHILLING_CLOUD_STORAGE_URL=https://<project-ref>.supabase.co
# SHILLING_CLOUD_STORAGE_KEY=<server-only-storage-api-key>
# SHILLING_CLOUD_STORAGE_BUCKET=cloud-peer
# SHILLING_BACKUP_HEALTH_PORT=8082
# SHILLING_BACKUP_MAX_CONNECTIONS=32
# SHILLING_BACKUP_MAX_HOUSEHOLDS=256
# Required for trusted-cloud mode: 32 random bytes encoded as base64; keep in a secret manager.
# SHILLING_BACKUP_STORAGE_KEY=<base64-key>

# Optional direct cloud-worker MCP endpoint; HTTPS reverse proxy must preserve Host.
# Leave unset to disable remote MCP. This is served on the worker's health HTTP port,
# not on the signaling server. Each client additionally needs an explicit household grant.
# SHILLING_CLOUD_MCP_URL=https://cloud-peer.example.com/mcp
# RevenueCat server API v2 (all four values are required together to enable paid plans).
# Keep the secret key server-side. Entitlement IDs are RevenueCat IDs, not display names.
# SHILLING_REVENUECAT_PROJECT_ID=proj_...
# SHILLING_REVENUECAT_SECRET_KEY=sk_...
# SHILLING_REVENUECAT_SILVER_ENTITLEMENT_ID=entl_...
# SHILLING_REVENUECAT_GOLD_ENTITLEMENT_ID=entl_...

# Public SDK keys and offering IDs used by the mobile purchase UI.
# SHILLING_REVENUECAT_ANDROID_PUBLIC_KEY=goog_...
# SHILLING_REVENUECAT_IOS_PUBLIC_KEY=appl_...
# SHILLING_REVENUECAT_SILVER_OFFERING_ID=silver
# SHILLING_REVENUECAT_GOLD_OFFERING_ID=gold

# RevenueCat Web Purchase Links for web and desktop checkout.
# Use production links here; the client appends the authenticated account ID.
# SHILLING_REVENUECAT_SILVER_WEB_LINK=https://pay.rev.cat/...
# SHILLING_REVENUECAT_GOLD_WEB_LINK=https://pay.rev.cat/...
