CREATE TABLE bookkeeping(
    space_id TEXT NOT NULL,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    PRIMARY KEY(space_id, entity_type, entity_id)

);

selectByEntity:
SELECT * FROM bookkeeping WHERE entity_type = ? AND entity_id = ? AND space_id = :space_id;

selectByType:
SELECT * FROM bookkeeping WHERE entity_type = ? AND space_id = :space_id;

upsert {
  INSERT OR IGNORE INTO bookkeeping(entity_type, entity_id, timestamp, space_id) VALUES (:entity_type, :entity_id, :timestamp, :space_id);
  UPDATE bookkeeping SET timestamp = :timestamp WHERE space_id = :space_id AND entity_type = :entity_type AND entity_id = :entity_id;
}

deleteByEntity:
DELETE FROM bookkeeping WHERE entity_type = ? AND entity_id = ? AND space_id = :space_id;

deleteByType:
DELETE FROM bookkeeping WHERE entity_type = ? AND space_id = :space_id;

deleteAll:
DELETE FROM bookkeeping WHERE space_id = :space_id;

claimLegacy:
UPDATE bookkeeping SET space_id = ? WHERE space_id = '__local__';
