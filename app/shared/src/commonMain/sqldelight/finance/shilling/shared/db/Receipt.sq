CREATE TABLE receipts(
    space_id TEXT NOT NULL,
    id TEXT NOT NULL,
    posting_id TEXT,
    file_path TEXT NOT NULL,
    original_name TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    receipt_date INTEGER,
    amount REAL,
    notes TEXT,
    FOREIGN KEY(space_id, posting_id) REFERENCES postings(space_id, id) ON UPDATE CASCADE,
    PRIMARY KEY(space_id, id)
);




selectById:
SELECT * FROM receipts WHERE id = ? AND space_id = :space_id;

selectAll:
SELECT * FROM receipts WHERE space_id = :space_id ORDER BY added_at DESC;

selectByPostingId:
SELECT * FROM receipts WHERE posting_id = ? AND space_id = :space_id ORDER BY added_at ASC;

selectAllWithPostings:
SELECT r.id, r.posting_id, r.file_path, r.original_name, r.added_at, r.receipt_date, r.amount, r.notes,
       COALESCE(p.title, s.title) AS posting_title,
       p.date AS posting_date
FROM receipts r
LEFT JOIN postings p ON r.posting_id = p.id AND p.space_id = r.space_id
LEFT JOIN schedules s ON p.schedule_id = s.id AND s.space_id = r.space_id WHERE r.space_id = :space_id
ORDER BY r.added_at DESC;

upsert {
  INSERT OR IGNORE INTO receipts(id, posting_id, file_path, original_name, added_at, receipt_date, amount, notes, space_id) VALUES (:id, :posting_id, :file_path, :original_name, :added_at, :receipt_date, :amount, :notes, :space_id);
  UPDATE receipts SET posting_id = :posting_id, file_path = :file_path, original_name = :original_name, added_at = :added_at, receipt_date = :receipt_date, amount = :amount, notes = :notes WHERE space_id = :space_id AND id = :id;
}

attachToPosting:
UPDATE receipts SET posting_id = ? WHERE id = ? AND space_id = :space_id;

detachFromPosting:
UPDATE receipts SET posting_id = NULL WHERE id = ? AND space_id = :space_id;

updateMetadata:
UPDATE receipts SET notes = ?, receipt_date = ?, amount = ? WHERE id = ? AND space_id = :space_id;

deleteById:
DELETE FROM receipts WHERE id = ? AND space_id = :space_id;

deleteAll:
DELETE FROM receipts WHERE space_id = :space_id;

claimLegacy:
UPDATE receipts SET space_id = ? WHERE space_id = '__local__';


detachByPosting:
UPDATE receipts SET posting_id = NULL WHERE space_id = :space_id AND posting_id = :posting_id;

detachByAccount:
UPDATE receipts SET posting_id = NULL WHERE space_id = :space_id AND posting_id IN (
  SELECT id FROM postings WHERE space_id = :space_id AND account_id = :account_id
);

detachBySchedule:
UPDATE receipts SET posting_id = NULL WHERE space_id = :space_id AND posting_id IN (
  SELECT id FROM postings WHERE space_id = :space_id AND schedule_id = :schedule_id
);
