{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-2.5.0/main/crates/tauri-utils/schema.json",
  "productName": "Shilling",
  "version": "0.1.0",
  "identifier": "finance.shilling.desktop",
  "build": {
    "beforeBuildCommand": "bash ./build-web.sh",
    "frontendDist": "../web-app-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Shilling",
        "width": 1200,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 28
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Household budgeting across your devices",
    "longDescription": "Plan recurring income and expenses, track what cleared, and see what is coming up in a weekly view.",
    "homepage": "https://github.com/j1philli/shilling",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
