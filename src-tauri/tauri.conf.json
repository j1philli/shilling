{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-2.5.0/main/crates/tauri-utils/schema.json",
  "productName": "Shilling",
  "version": "0.1.0",
  "identifier": "finance.shilling.desktop",
  "build": {
    "beforeBuildCommand": "bash ./build-web.sh",
    "frontendDist": "../web-app-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Shilling",
        "width": 1200,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 28
        }
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
