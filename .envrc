# ── Tool paths ───────────────────────────────────────────────────────
# Cargo (Tauri CLI)
path_add PATH "$HOME/.cargo/bin"

# Prefer the supported Node LTS installed by Brewfile.
if command -v brew >/dev/null 2>&1 && [ -d "$(brew --prefix node@22 2>/dev/null)/bin" ]; then
    path_add PATH "$(brew --prefix node@22)/bin"
fi

# Java (Kotlin Toolchain/Kotlin compiler) — JDK 25.0.5+ from `just setup`, or 21.0.13+
if [ -d "$HOME/.local/share/shilling/jdk-25.0.5.0.2" ]; then
    export JAVA_HOME="$HOME/.local/share/shilling/jdk-25.0.5.0.2"
elif [ -d "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home" ]; then
    export JAVA_HOME="/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
elif command -v brew >/dev/null 2>&1 && [ -d "$(brew --prefix openjdk@21 2>/dev/null)/libexec/openjdk.jdk/Contents/Home" ]; then
    export JAVA_HOME="$(brew --prefix openjdk@21)/libexec/openjdk.jdk/Contents/Home"
elif command -v /usr/libexec/java_home >/dev/null 2>&1; then
    export JAVA_HOME="$(/usr/libexec/java_home -v 21 2>/dev/null || true)"
fi
if [ -n "${JAVA_HOME:-}" ]; then
    path_add PATH "$JAVA_HOME/bin"
fi

# ── Dependency checks ───────────────────────────────────────────────
missing=()
command -v just  >/dev/null || missing+=("just")
command -v node  >/dev/null || missing+=("node")
command -v cargo >/dev/null || missing+=("cargo/rust")
command -v java  >/dev/null || missing+=("openjdk")

if [ ${#missing[@]} -gt 0 ]; then
    log_error "Missing tools: ${missing[*]}"
    log_error "Run: brew bundle"
    return 1
fi

# Auto-install npm deps if node_modules is missing
if [ ! -d "node_modules" ]; then
    log_status "Installing npm dependencies..."
    npm install
fi
