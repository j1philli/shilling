#!/usr/bin/env bash
#MISE description="Stream iOS Simulator app logs (run in a separate terminal)"
set -euo pipefail

DATA_DIR="$(xcrun simctl get_app_container booted finance.shilling.app data 2>/dev/null || true)"
if [ -z "$DATA_DIR" ]; then
    echo "Error: finance.shilling.app not installed on booted simulator" >&2
    exit 1
fi
LOG_FILE="${DATA_DIR}/tmp/shilling-ios.log"
: > "$LOG_FILE"
echo "Tailing $LOG_FILE (truncated) ..."
tail -f "$LOG_FILE"
